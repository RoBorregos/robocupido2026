generator client {
    provider        = "prisma-client-js"
    output          = "../generated/prisma"
    previewFeatures = ["postgresqlExtensions"]
}

datasource db {
    provider   = "postgresql"
    url        = env("DATABASE_URL")
    extensions = [vector]
}

model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String?
    access_token             String?
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String?
    session_state            String?
    refresh_token_expires_in Int?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]

    age         Int?
    instagram   String?
    gender      String?
    preferences String?
    lookingFor  String?
    loveLanguage String?
    carrera     String?
    semestre    Int?
    aboutMe     String?
    aboutThem   String?
    profileDescription String?

    aboutMeEmbedding   Unsupported("vector(1536)")?
    aboutThemEmbedding Unsupported("vector(1536)")?

    // Matches where this user is the one receiving matches
    matchesReceived Match[] @relation("UserMatches")
    // Matches where this user is the matched person
    matchesGiven    Match[] @relation("MatchedUser")
}

model Match {
    id          String   @id @default(cuid())
    userId      String
    matchedId   String
    score       Float    // Similarity score (0-100 percentage)
    rank        Int      // 1st, 2nd, 3rd, 4th match
    createdAt   DateTime @default(now())

    user        User     @relation("UserMatches", fields: [userId], references: [id], onDelete: Cascade)
    matched     User     @relation("MatchedUser", fields: [matchedId], references: [id], onDelete: Cascade)

    @@unique([userId, matchedId])
    @@index([userId])
    @@index([matchedId])
}
